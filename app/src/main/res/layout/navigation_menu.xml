<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menulayout"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCurrentHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@android:style/TextAppearance.Medium"
                        android:textSize="16sp"
                        tools:text="http://localhost:8090"/>
                    <!--android:textColor="?attr/colorHost"-->

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="true"
                        android:paddingStart="4dp"
                        android:paddingLeft="4dp"
                        android:paddingEnd="4dp"
                        android:paddingRight="4dp"
                        android:gravity="center"
                        tools:text="Status"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTorrents"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/torrents"
                app:icon="@drawable/round_view_list_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlaylist"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/playlist"
                app:icon="@drawable/ic_outline_playlist_play" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add"
                app:icon="@drawable/ic_outline_add" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="12dp"
                android:background="?attr/colorControlHighlight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnServers"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/servers"
                app:icon="@drawable/ic_mdns" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnServerSettings"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/torserver_title"
                app:icon="@drawable/ic_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategories"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/categories"
                app:icon="@drawable/round_view_list_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                app:icon="@drawable/ic_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update"
                app:icon="@drawable/ic_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDonate"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/donate"
                app:icon="@drawable/ic_thumb_up" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="12dp"
                android:background="?attr/colorControlHighlight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveAll"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remove_all"
                app:icon="@drawable/ic_outline_remove" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                style="@style/NavigationMenuButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exit"
                app:icon="@drawable/ic_outline_exit_to_app" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
